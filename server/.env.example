PORT=3002
DATABASE_PATH=./data/agentguard.sqlite
FRONTEND_URL=http://localhost:5173

# Groq free-tier-compatible tool-calling setup. Create a key at https://console.groq.com/keys.
# The free tier has usage limits; check your account's current limits and available models.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Optional alternatives: set LLM_PROVIDER, LLM_BASE_URL, LLM_API_KEY, and LLM_MODEL
# for another OpenAI-compatible tool-calling service. OpenAI legacy variables also work:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Local Ollama endpoint (no key): http://localhost:11434/v1

# PayPal Developer Sandbox REST app credentials (never live endpoints).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
